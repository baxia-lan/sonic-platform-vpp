"""VPP platform — BUILD.bazel added on claude branch.

Migration status: Phase 1 Bazel migration.
Build type: GNU Make (.mk rules + platform conf)

VPP (Vector Packet Processing) platform plugin for SONiC. Contains
Make-based build rules and platform configuration for DPDK-accelerated
packet processing.
"""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(
        ["**/*"],
        exclude = [".git/**", "build/**"],
    ),
)

filegroup(
    name = "platform_rules",
    srcs = glob(["*.mk", "*.dep", "*.conf"]),
)

genrule(
    name = "vpp_platform",
    srcs = [":all_srcs"],
    outs = ["vpp-platform.tar.gz"],
    cmd = """
set -euo pipefail
SOURCE_DATE_EPOCH=0 tar --sort=name --mtime=@0 \
  --owner=0 --group=0 \
  -czf $(OUTS) -C $$(dirname $(location :all_srcs)) .
""",
    tags = ["manual", "platform"],
    visibility = ["//visibility:public"],
)

