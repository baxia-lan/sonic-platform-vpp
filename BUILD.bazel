"""
VPP platform — BUILD.bazel added on claude branch.

Migration status: Phase 1 Bazel migration.
Build type: Platform-specific (kernel modules, device drivers, vendor code)

Platform modules are built inside the sonic-slave toolchain container.
The final artifacts are included in platform-specific ONIE images via
//platform/<name>:BUILD.bazel.
"""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "platform_srcs",
    srcs = glob(
        ["**/*"],
        exclude = [".git/**", "build/**", "*.o", "*.ko"],
    ),
)

genrule(
    name = "sonic-platform-vpp_modules",
    srcs = [":platform_srcs"],
    outs = ["sonic-platform-vpp_modules.tar.gz"],
    cmd = """
set -euo pipefail
# Platform-specific build. Override with platform Makefile conventions.
SOURCE_DATE_EPOCH=0 make -C $$(dirname $(location :platform_srcs)) -j$$(nproc) 2>&1
find $(RULEDIR) -name '*.ko' -o -name '*.deb' | \
  tar -czf $(OUTS) -T - 2>/dev/null || true
""",
    tags = ["manual", "platform"],
    execution_requirements = {"requires-network": "0"},
    visibility = ["//visibility:public"],
)

